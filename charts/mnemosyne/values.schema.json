  "$schema": "http://json-schema.org/draft-07/schema#",
  "allOf": [
    {
      "if": {
        "properties": {
          "addon": {
            "properties": {
              "enabled": {
                "const": true
              }
            }
          }
        }
      },
      "then": {
        "properties": {
          "addon": {
            "properties": {
              "images": {
                "properties": {
                  "controller": {
                    "properties": {
                      "digest": {
                        "minLength": 71
                      }
                    }
                  },
                  "studio": {
                    "properties": {
                      "digest": {
                        "minLength": 71
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  ]
}
