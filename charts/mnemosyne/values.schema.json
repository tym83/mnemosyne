        "artifacts": {
          "type": "object",
          "properties": {
            "existingClaim": {
              "type": "string"
            }
          }
        }
      }
    },
    "servers": {
      "type": "array",
      "items": {}
    },
    "notagen": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "directory": {
          "type": "string"
        },
        "device": {
          "type": "string"
        },
        "weightsFile": {
          "type": "string"
        },
        "weights": {
          "type": "object",
          "properties": {
            "existingClaim": {
              "type": "string"
            },
            "size": {
              "type": "string"
            },
            "storageClass": {
              "type": "string"
            }
          }
        }
      }
    },
    "addon": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "rbacScope": {
          "type": "string",
          "enum": [
            "cluster",
            "namespace"
          ]
        },
        "manageQuota": {
          "type": "boolean"
        },
        "controllerReplicas": {
          "const": 1
        },
        "images": {
          "type": "object",
          "properties": {
            "controller": {
              "type": "object",
              "properties": {
                "repository": {
                  "type": "string"
                },
                "digest": {
                  "type": "string",
                  "pattern": "^$|^sha256:[a-f0-9]{64}$"
                }
              }
            },
            "studio": {
              "type": "object",
              "properties": {
                "repository": {
                  "type": "string"
                },
                "digest": {
                  "type": "string",
                  "pattern": "^$|^sha256:[a-f0-9]{64}$"
                }
              }
            }
          }
        },
        "imagePullSecrets": {
          "type": "array",
          "items": {}
        },
        "mode": {
          "type": "string",
          "enum": [
            "chamber",
            "background",
            "GPU",
            "API"
          ]
        },
        "gpuResource": {
          "type": "string"
        },
        "render": {
          "type": "boolean"
        },
        "suspend": {
          "type": "boolean"
        },
        "window": {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "enum": [
                "night",
                "weekends",
                "idle",
                "always",
                "continuous"
              ]
            },
            "timeZone": {
              "type": "string"
            },
            "startHour": {
              "type": "integer",
              "minimum": 0,
              "maximum": 23
            },
            "endHour": {
              "type": "integer",
              "minimum": 0,
              "maximum": 23
            }
          }
        },
        "deadlineSeconds": {
          "type": "integer",
          "minimum": 60
        },
        "snapshotNamespace": {
          "type": "string"
        },
        "includeSecrets": {
          "type": "boolean"
        },
        "inventory": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": [
              "apiVersion",
              "kind",
              "resource"
            ],
            "properties": {
              "names": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "string"
                }
              },
              "apiVersion": {
                "type": "string",
                "pattern": "^[a-z0-9.-]+(/[a-z0-9]+)?$"
              },
              "kind": {
                "type": "string",
                "pattern": "^[A-Za-z][A-Za-z0-9]*$"
              },
              "resource": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9]*$"
              }
            }
          }
        },
        "priorityClassName": {
          "type": "string"
        },
        "resources": {
          "type": "object",
          "properties": {
            "requests": {
              "type": "object",
              "properties": {
                "cpu": {
                  "type": "string"
                },
                "memory": {
                  "type": "string"
                }
              }
            },
            "limits": {
              "type": "object",
              "properties": {
                "cpu": {
                  "type": "string"
                },
                "memory": {
                  "type": "string"
                }
              }
            }
          }
        },
        "quota": {
          "type": "object",
          "properties": {
            "requests.cpu": {
              "type": "string"
            },
            "requests.memory": {
              "type": "string"
            },
            "limits.cpu": {
              "type": "string"
            },
            "limits.memory": {
              "type": "string"
            },
            "pods": {
              "type": "string"
            }
          }
        },
        "history": {
          "type": "object",
          "properties": {
            "source": {
              "type": "string",
              "pattern": "^$|^https://"
            },
            "sha256": {
              "type": "string",
              "pattern": "^$|^[a-f0-9]{64}$"
            }
          }
        },
        "gallery": {
          "type": "object",
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "refreshSeconds": {
              "type": "integer"
            },
            "service": {
              "type": "object",
              "properties": {
                "type": {
                  "type": "string",
                  "enum": [
                    "ClusterIP",
                    "NodePort",
                    "LoadBalancer"
                  ]
                },
                "port": {
                  "type": "integer"
                }
              }
            },
            "ingress": {
              "type": "object",
