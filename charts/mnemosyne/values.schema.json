        "env": {
          "type": "array",
          "items": {}
        },
        "volumes": {
          "type": "array",
          "items": {}
        },
        "volumeMounts": {
          "type": "array",
          "items": {}
        },
        "nodeSelector": {
          "type": "object",
          "properties": {}
        },
        "tolerations": {
          "type": "array",
          "items": {}
        }
